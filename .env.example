# Kairix Express Page Builder deployment example

# Use a unique project name and secret directory for every new client instance.
COMPOSE_PROJECT_NAME=kairix-client-name
KAIRIX_SECRETS_DIR=/opt/kairix/clients/client-name/secrets

NODE_ENV=production
ADMIN_BIND_IP=127.0.0.1
ADMIN_PORT=8040
PREVIEW_BIND_IP=127.0.0.1
PUBLIC_PREVIEW_PORT=4321
PORT=8080
ALLOW_INSECURE_ADMIN_BIND=false

DATABASE_PATH=/app/data/kairix.sqlite
UPLOADS_DIR=/app/uploads
GENERATED_SITE_DIR=/app/generated-site/current
PUBLIC_BUILD_TEMP_DIR=/app/generated-site/.publish-staging
BACKUPS_DIR=/app/data/backups
VITE_CACHE_DIR=/tmp/kairix-vite-site
MAX_UPLOAD_MB=25
ENABLE_SAMPLE_DATA_TOOLS=false
PUBLISH_MAX_FILES=20000
PUBLISH_MAX_TOTAL_MB=500
PUBLISH_MAX_FILE_MB=25

# Template for a new dedicated single-client instance. Do not copy these future
# settings into the current live LAN stack until its Tunnel, hostname, and
# Cloudflare Access policy have been created and tested.
TRUST_PROXY=true
COOKIE_SECURE=true
ADMIN_BASE_URL=https://client-name.manager.example.com
ADMIN_HOSTNAME=client-name.manager.example.com
PUBLIC_BASE_URL=https://client-worker.example-account.workers.dev
PUBLIC_SITE_BASE_PATH=
PUBLIC_HOSTNAME=

# Required in production. A *_FILE value takes precedence over its environment
# variable. Do not set placeholder environment values when using secret files.
SESSION_SECRET=
SESSION_SECRET_FILE=
# Dedicated-server value: /run/kairix-secrets/session-secret
SESSION_LIFETIME_HOURS=12
ENCRYPTION_SECRET=
ENCRYPTION_SECRET_FILE=
# Dedicated-server value: /run/kairix-secrets/encryption-secret

# Demo mode A: single admin URL with built-in preview
# - Expose only the admin service.
# - Public preview is served by the admin at /preview/.
# - Keep PUBLIC_SITE_BASE_PATH=/preview.
# - PUBLIC_BASE_URL should be the admin hostname origin.

# Binding policy:
# - ADMIN_BIND_IP and PREVIEW_BIND_IP must remain loopback in production.
# - ALLOW_INSECURE_ADMIN_BIND is an emergency compatibility escape hatch only.
#   It must remain false for the dedicated-server/Cloudflare Tunnel design.
# - PORT is the fixed internal application port; normally leave it at 8080.

# The optional public-preview container is bound to localhost for operator testing.
# Do not route it as the production public site.

# AliExpress Open Platform endpoints and credentials are configured in Settings.
# Leave endpoint values empty until you have confirmed the official endpoints for your app.
ALIEXPRESS_AUTH_URL=
ALIEXPRESS_TOKEN_URL=
ALIEXPRESS_API_URL=

# Publishing mode for a dedicated client Worker.
DEPLOY_PROVIDER=cloudflare-workers

# Shared Cloudflare authentication. Required for cloudflare-pages and
# cloudflare-workers. The API token is server-only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKEN_FILE=
# Dedicated-server value: /run/kairix-secrets/cloudflare-api-token
CLOUDFLARE_DEPLOY_TIMEOUT_MS=600000
CLOUDFLARE_PREFLIGHT_TIMEOUT_MS=15000

# Required only when DEPLOY_PROVIDER=cloudflare-pages.
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_BRANCH=main

# Required only when DEPLOY_PROVIDER=cloudflare-workers.
# Also set PUBLIC_BASE_URL to the Worker's HTTPS workers.dev/custom-domain
# origin, set PUBLIC_SITE_BASE_PATH= (empty), and keep PUBLIC_HOSTNAME= empty.
CLOUDFLARE_WORKER_NAME=kairix-client-name
